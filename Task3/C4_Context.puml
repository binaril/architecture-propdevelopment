@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title PropDevelopment. Приложение для собственников. Диаграмма контекста


Person(owner, "Собственник", "Владелец жилья, купленного у компании")
Person(manager, "Менеджер", "Управление CRM")
Person(accountant, "Бухгалтер", "Финансовый специалист")

System(owner_app, "Мобильное приложение для собственников", "Управление услугами, ЖКХ, умным домом")

System_Ext(smart_intercom, "Интеллектуальный домофон", "Видеодомофон с распознаванием лиц")
System_Ext(smart_barrier, "Интеллектуальный шлагбаум", "Управление доступом с распознаванием номеров")
System_Ext(communal_service, "Поставщик ЖКХ")
System_Ext(pay_system, "Платёжная система")

Rel(owner, owner_app, "Управляет услугами ЖКХ и умного дома")
Rel(manager, owner_app, "Управление данными о собственниках в CRM")
Rel(accountant, owner_app, "Ведёт учёт")

Rel(owner_app, smart_intercom, "Просмотр видео, управление замком")
Rel(owner_app, smart_barrier, "Управляет шлагбаумом")
Rel(owner_app, communal_service, "Счета и оплата")
Rel(owner_app, pay_system, "Проведение платежей")

@enduml